{
  "name": "@cityofbinary/react-scrolls",
  "version": "0.1.0",
  "description": "A lightweight React infinite scroller powered by IntersectionObserver.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityofbinary/react-scrolls.git"
  },
  "homepage": "https://github.com/cityofbinary/react-scrolls#readme",
  "bugs": {
    "url": "https://github.com/cityofbinary/react-scrolls/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": ["react", "infinite-scroll", "scroller", "typescript", "intersection-observer"],
  "peerDependencies": { "react": ">=16.8.0" },
  "devDependencies": { "@types/react": "^19.0.0", "tsup": "^8.0.0", "typescript": "^5.0.0" },
  "publishConfig": { "access": "public" }
}
